{
  "name": "serverest-cypress-tests",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "ajv": "^8.20.0",
    "cypress": "^15.18.1",
    "eslint": "^10.6.0",
    "eslint-plugin-cypress": "^6.4.2",
    "globals": "^17.7.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  },
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:ci": "node scripts/run-cypress.js",
    "test": "npm run cypress:run",
    "lint": "eslint .",
    "report:merge": "mochawesome-merge ./cypress/reports/mochawesome/*.json > ./cypress/reports/mochawesome.json",
    "report:generate": "marge ./cypress/reports/mochawesome.json -f mochawesome-report -o ./cypress/reports",
    "report:clean": "node -e \"require('fs').rmSync('cypress/reports', { recursive: true, force: true })\""
  }
}
